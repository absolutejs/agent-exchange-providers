{
  "compilerOptions": {
    "baseUrl": ".",
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@absolutejs/agent-exchange-oauth": ["../oauth/src/index.ts"],
      "@absolutejs/agent-exchange-provider-conformance": [
        "../conformance/src/index.ts"
      ]
    },
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
