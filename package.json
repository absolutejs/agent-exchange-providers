{
  "name": "@absolutejs/agent-exchange-providers",
  "private": true,
  "type": "module",
  "workspaces": [
    "webauthn",
    "oauth"
  ],
  "scripts": {
    "build": "bun run --filter './*' build",
    "check:package": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"./**/*.{ts,json,md}\"",
    "test": "bun run --filter './*' test",
    "typecheck": "bun run --filter './*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.0",
    "typescript": "^5.9.0"
  }
}
