{
  "name": "@absolutejs/agent-exchange-local",
  "version": "0.1.0",
  "description": "Model-blind local encrypted code delivery and expiring private clipboard adapters.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/agent-exchange-providers.git",
    "directory": "local"
  },
  "homepage": "https://github.com/absolutejs/agent-exchange-providers/tree/main/browser",
  "bugs": {
    "url": "https://github.com/absolutejs/agent-exchange-providers/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./windows": {
      "types": "./dist/windows.d.ts",
      "import": "./dist/windows.js",
      "default": "./dist/windows.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts src/windows.ts --outdir dist --root src --target=bun --external @absolutejs/agent-exchange --external @absolutejs/e2ee-webcrypto && tsc --project tsconfig.build.json",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"./**/*.{ts,json,md}\"",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "check:package": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run check:package"
  },
  "devDependencies": {
    "@absolutejs/agent-exchange": "0.5.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0",
    "@absolutejs/agent-exchange-destinations": "0.3.1",
    "@absolutejs/e2ee-webcrypto": "0.2.1"
  },
  "peerDependencies": {
    "@absolutejs/agent-exchange": ">=0.5.0 <0.6",
    "@absolutejs/e2ee-webcrypto": ">=0.2.1 <0.3"
  }
}
