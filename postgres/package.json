{
  "name": "@absolutejs/agent-exchange-postgres",
  "version": "0.1.0",
  "description": "Durable tenant-scoped Agent Exchange requests, replay protection and broker claims for PostgreSQL.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Kahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/agent-exchange-providers.git",
    "directory": "postgres"
  },
  "homepage": "https://github.com/absolutejs/agent-exchange-providers/tree/main/postgres",
  "bugs": {
    "url": "https://github.com/absolutejs/agent-exchange-providers/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --root src --sourcemap --target=browser --external @absolutejs/agent-exchange && tsc --project tsconfig.build.json",
    "format": "prettier --write \"./**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"./**/*.{ts,json,md}\"",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "check:package": "bun run format:check && bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run check:package"
  },
  "devDependencies": {
    "@absolutejs/agent-exchange": "0.5.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0",
    "@absolutejs/agent-exchange-broker": "0.3.0"
  },
  "peerDependencies": {
    "@absolutejs/agent-exchange": ">=0.5.0 <0.6",
    "@absolutejs/agent-exchange-broker": ">=0.3.0 <0.4"
  }
}
